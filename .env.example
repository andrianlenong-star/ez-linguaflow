# GEMINI_API_KEY: Required server-side secret for Gemini AI translation, OCR, dictionary, STT, and TTS.
# Never expose this key to Web frontend or Android app builds.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for primary Gemini translation model (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# DEEPL_API_KEY: Optional server-side secret for official DeepL API provider.
DEEPL_API_KEY=""

# SERVER RUNTIME CONFIGURATION
PORT="3000"
NODE_ENV="development"
LOG_LEVEL="info"
REQUEST_TIMEOUT_MS="90000"
RATE_LIMIT_MAX="90"

# CORS & AUTH ENFORCEMENT
# Comma-separated Web origins allowed by CORS (empty allows same-origin & native Android requests).
ALLOWED_ORIGINS=""
# Set to "true" in strict production deployments if translation endpoints should reject unauthenticated requests.
REQUIRE_AUTH_FOR_TRANSLATION="false"

# APP_URL: Hosted Cloud Run / preview URL.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional override if frontend is hosted separately from the API backend.
# Leave empty when using unified Node server or Vercel /api serverless functions.
VITE_API_BASE_URL=""
